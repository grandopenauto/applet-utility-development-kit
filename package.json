{
  "name": "audk",
  "version": "2.3.0",
  "private": true,
  "description": "Applet Utility Development Kit: build, configure, inspect, test and export reusable applets and macros",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:express": "node src/express-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-library.mjs",
    "discover:python": "python tools/python_discover.py --output catalog/python-standard-library.json",
    "generate": "node scripts/generate-applet.mjs",
    "review:propose": "node scripts/promote-review.mjs",
    "review:stage": "node scripts/stage-promoted-applet.mjs",
    "expansion:scan": "node scripts/build-expansion-queue.mjs",
    "expansion:diff": "node scripts/diff-python-catalog.mjs",
    "assembly:plan": "node scripts/assemble-library.mjs",
    "assembly:build-trusted": "node scripts/build-trusted-applets.mjs",
    "build:serve-private": "node scripts/start-private-build-api.mjs",
    "build:work-once": "node scripts/run-private-build-worker.mjs",
    "worker:restricted": "node scripts/run-restricted-worker.mjs",
    "worker:lock": "node scripts/create-worker-source-lock.mjs",
    "build:verify": "node scripts/verify-build-evidence.mjs",
    "build:import-handoff": "node scripts/import-build-handoff.mjs",
    "intake:serve-private": "node scripts/start-intake-gateway.mjs",
    "production:batch": "node scripts/produce-applet-batch.mjs",
    "reference:python": "node scripts/capture-python-references.mjs",
    "development:recipes": "node scripts/prepare-sdk-recipes.mjs",
    "parity:javascript": "node scripts/compare-javascript-parity.mjs"
  },
  "optionalDependencies": {
    "express": "^5.1.0"
  }
}
